# Copy to lms/docker/.env (gitignored). `make up` does this for you on first run and replaces the two
# change-me placeholders below with random passwords; if you copy by hand, set them yourself.
MOODLE_WWWROOT=http://localhost:8080
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=change-me-db
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD='Change-me-1!'
MOODLE_ADMIN_EMAIL=admin@example.invalid
MOODLE_SITE_FULLNAME="TrustForma"
MOODLE_SITE_SHORTNAME=TrustForma
# --- Outgoing mail (all of it lives here; config.php forces it, so the Moodle admin UI shows it locked).
# Local pilot: Mailpit, no authentication. To go live set the block below (and see README "Correo saliente").
# Host port of the Mailpit web UI (default 8025); change it if another program already uses it.
# MAILPIT_PORT=8025
MOODLE_SMTP_HOST=mailpit:1025
MOODLE_NOREPLY=noreply@example.invalid
# '' (none) | tls (STARTTLS, use with port 587) | ssl (implicit TLS)
MOODLE_SMTP_SECURE=
# '' (= LOGIN) | LOGIN | PLAIN | XOAUTH2 . XOAUTH2 = OAuth 2 (recommended; basic auth is refused by Microsoft 365 and discouraged elsewhere).
MOODLE_SMTP_AUTHTYPE=
# Service mailbox used to send (XOAUTH2 "user=" value / SMTP login), e.g. noreply@your-company.com. Never a personal mailbox.
MOODLE_SMTP_USER=
# Only for LOGIN/PLAIN. Ignored (and never set) with XOAUTH2.
MOODLE_SMTP_PASSWORD=
# XOAUTH2 only. Provider: microsoft | google. Values come from the Entra app registration / Google Cloud OAuth client.
MOODLE_SMTP_OAUTH_PROVIDER=
MOODLE_SMTP_OAUTH_CLIENT_ID=
MOODLE_SMTP_OAUTH_CLIENT_SECRET=
# microsoft only: Directory (tenant) ID.
MOODLE_SMTP_OAUTH_TENANT=
# --- Compliance API token (read by the GRC portal's awareness-import). Optional: only these addresses may use it,
# comma-separated IPs or subnets (the importer host's outbound address). Empty = any address. Applied by `make configure`.
MOODLE_GRC_TOKEN_IPS=
# Production behind a TLS-terminating proxy: MOODLE_SSLPROXY=1 (and MOODLE_WWWROOT=https://...).
MOODLE_SSLPROXY=0
# Only if the proxy serves Moodle under another host/port than Moodle sees itself (disables a wwwroot check).
MOODLE_REVERSEPROXY=0
