# Moodle 4.5 LTS on Alpine: php-fpm image ("moodle" target) + nginx image ("web" target), built from one file.
# Versions come from plugins.lock via build args (see compose.alpine.yaml). Bases pinned by digest; Moodle and customcert pinned by commit SHA.
ARG PHP_IMAGE=php:8.3-fpm-alpine@sha256:454b11c8907e32878ce92e87b13c14e1bbe6e1b10f4f96d4a19c9b62ec675d41
ARG NGINX_IMAGE=nginx:stable-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94

# ---- stage 1: fetch sources. git never reaches the final images.
FROM ${PHP_IMAGE} AS fetch
ARG MOODLE_REPO
ARG MOODLE_COMMIT
ARG CUSTOMCERT_REPO
ARG CUSTOMCERT_COMMIT
RUN apk add --no-cache git ca-certificates
RUN set -eux; \
    fetch() { \
        dir="$1"; repo="$2"; sha="$3"; \
        git init -q "$dir"; \
        git -C "$dir" fetch -q --depth 1 "$repo" "$sha"; \
        git -C "$dir" checkout -q FETCH_HEAD; \
        test "$(git -C "$dir" rev-parse HEAD)" = "$sha"; \
        rm -rf "$dir/.git"; \
    }; \
    fetch /out/moodle "${MOODLE_REPO}" "${MOODLE_COMMIT}"; \
    fetch /out/customcert "${CUSTOMCERT_REPO}" "${CUSTOMCERT_COMMIT}"
# The code is read, never executed as a program and never written at run time: plain 755 folders and 644 files, owned by root
# (COPY --from keeps these modes; without --chown the owner is root).
RUN find /out -type d -exec chmod 755 {} + && find /out -type f -exec chmod 644 {} +

# ---- stage 2: php-fpm runtime
FROM ${PHP_IMAGE} AS moodle
ARG MOODLE_TAG
ARG CUSTOMCERT_TAG
LABEL org.opencontainers.image.title="awareness-lms moodle (php-fpm, alpine)" \
      io.awareness.moodle.tag="${MOODLE_TAG}" io.awareness.customcert.tag="${CUSTOMCERT_TAG}"

# Runtime tools stay; the -dev packages and compilers live in the .build-deps virtual package and are removed after the extensions are built.
# Runtime libraries the compiled extensions link against are kept (.moodle-rundeps), computed from the ELF headers (docker-library idiom).
# icu-data-full: intl needs the full ICU data for Spanish collation/formatting (the default Alpine ICU data is English-only).
RUN set -eux; \
    apk upgrade --no-cache; \
    apk add --no-cache ghostscript poppler-utils unzip tzdata icu-data-full; \
    apk add --no-cache --virtual .build-deps $PHPIZE_DEPS \
        icu-dev libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev libxml2-dev postgresql-dev; \
    docker-php-ext-configure gd --with-freetype --with-jpeg; \
    docker-php-ext-install -j"$(nproc)" gd intl zip soap exif opcache pgsql pdo_pgsql; \
    runDeps="$(scanelf --needed --nobanner --format '%n#p' --recursive /usr/local \
        | tr ',' '\n' | sort -u | awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }')"; \
    apk add --no-cache --virtual .moodle-rundeps $runDeps; \
    apk del --no-network .build-deps; \
    rm -rf /tmp/* /var/cache/apk/*; \
    php -r 'foreach (["gd", "intl", "zip", "soap", "exif", "pgsql", "pdo_pgsql", "Zend OPcache", "mbstring", "xml", "dom", "simplexml", "xmlreader", "xmlwriter", "sodium", "iconv", "curl", "openssl", "fileinfo", "ctype", "json", "session", "tokenizer"] as $e) { if (!extension_loaded($e)) { fwrite(STDERR, "missing PHP extension: $e\n"); exit(1); } }'; \
    # Alpine's www-data is 82; the data volume, secrets/ and existing backups were written by uid 33: keep that id.
    sed -i 's/^www-data:x:82:82:/www-data:x:33:33:/' /etc/passwd; \
    sed -i 's/^www-data:x:82:/www-data:x:33:/' /etc/group; \
    test "$(id -u www-data)" = 33 && test "$(id -g www-data)" = 33

# PHP's production defaults (errors are logged, never displayed), then what Moodle needs. expose_php off: no X-Powered-By header.
# log_errors writes to stderr, which php-fpm passes on to the container log (`make logs`).
RUN set -eux; \
    cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"; \
    { \
      echo 'expose_php=Off'; \
      echo 'log_errors=On'; \
      echo 'max_input_vars=5000'; \
      echo 'upload_max_filesize=100M'; \
      echo 'post_max_size=100M'; \
      echo 'memory_limit=512M'; \
      echo 'opcache.enable=1'; \
      echo 'opcache.memory_consumption=192'; \
      echo 'opcache.max_accelerated_files=20000'; \
    } > /usr/local/etc/php/conf.d/moodle.ini
# clear_env=no: config.php reads its settings with getenv(); php-fpm workers otherwise start with an empty environment.
# --chmod: files copied from some filesystems (shared or network drives) arrive as 777.
COPY --chmod=0644 fpm-moodle.conf /usr/local/etc/php-fpm.d/zzz-moodle.conf

# Moodle core + pinned plugins, copied from the fetch stage (no .git, no git binary), owned by root: the runtime user (www-data)
# can read the code and cannot change it. The base image leaves /var/www/html world-writable; it must not stay so.
COPY --from=fetch /out/moodle /var/www/html
COPY --from=fetch /out/customcert /var/www/html/mod/customcert
RUN chown root:root /var/www/html && chmod 755 /var/www/html \
    && mkdir -p /var/www/moodledata && chown www-data:www-data /var/www/moodledata

# Config reads everything from environment variables (12-factor); no secrets in the image.
COPY --chmod=0644 config.php /var/www/html/config.php

WORKDIR /var/www/html

# ---- stage 3: nginx web tier. Static files come straight from disk; every .php goes to php-fpm (fastcgi_pass moodle:9000).
FROM ${NGINX_IMAGE} AS web
LABEL org.opencontainers.image.title="awareness-lms web (nginx, alpine)"
RUN apk upgrade --no-cache
COPY --from=fetch /out/moodle /var/www/html
COPY --from=fetch /out/customcert /var/www/html/mod/customcert
COPY --chmod=0644 nginx/moodle.conf /etc/nginx/conf.d/default.conf
