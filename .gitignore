# Build output (regenerated by `make build`)
build/

# Synthetic course created (and removed) by `make test-e2e`
courses/e2etest/

# Backups contain personal data (learner names, emails, results): never commit
backups/

# Secrets and local environment
lms/docker/.env
lms/docker/secrets/*
!lms/docker/secrets/.gitkeep
.env
*.env
.env.*
!.env.example
!lms/docker/.env.example

# Database/moodledata dumps contain personal data wherever they end up
*.pgdump
*.tgz
*.sql
*.sql.gz
*.dump

# INCIBE material is never committed. The operator downloads kit_concienciacion.zip from INCIBE and runs `make setup`:
# kit/ is written by `make import-kit APPLY=1`, the question banks by `make extract` (both are INCIBE content, not covered by the Unlicense).
kit/
courses/*/questions/M*.yaml
!courses/*/questions/.gitkeep
incibe-main/
# Phishing / USB simulation tooling from the INCIBE kit: never published, never committed
Ataques_dirigidos/
Manual_Gophish/

# Agent / tooling files are local only
AGENTS.md
CHANGELOG.md
CLAUDE.md
.snyk

# upload/ is the drop zone for INCIBE's kit_concienciacion.zip (547 MB, and it contains the tooling above): only the instructions are tracked
upload/*
!upload/README.md
!upload/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
